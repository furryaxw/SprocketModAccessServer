# Sprocket Mod Access Server local configuration template
# Sprocket Mod Access Server 本地配置模板

# Copy to .env. Do not commit real secrets.
# 复制为 .env。不要提交真实密钥。

# Server identity and local bind address
# 服务身份与本地监听地址
SMAS_SERVER_ID=development-server
SMAS_SERVER_NAME=Sprocket Developer Server
# Externally reachable base URL: absolute links always use it when set. Leave it empty to derive them
# from the request origin instead.
# 对外可达的基础地址：配了就一律用它拼绝对链接；留空则改用请求 origin。
SMAS_PUBLIC_BASE_URL=http://127.0.0.1:8787
SMAS_HOST=127.0.0.1
SMAS_PORT=8787
SMAS_PLATFORM_MODE=simple
SMAS_AUTO_REGISTER_USERS=true
SMAS_FIRST_LOGIN_PERMISSION_TEMPLATE=template.owner
SMAS_NEW_USER_PERMISSION_TEMPLATE=template.user
# Use DEBUG to trace backend auth/resource/database flow during local diagnosis.
SMAS_LOG_LEVEL=INFO

# Runtime state root: database, packages and logs resolve under it. A relative value is
# resolved against the checkout root; empty means the checkout root.
# 运行状态根目录：数据库、包与日志都挂在它下面。相对值按检出根解析；留空表示检出根。
SMAS_ROOT=

# SQLite and object storage
# SQLite 与对象存储
SMAS_DATABASE_URL=sqlite:///data/access.db
SMAS_OBJECT_STORAGE_URL=file:./data/packages

# Required random secrets; use different values in every environment
# 必填随机密钥；每个环境都应使用不同的值
SMAS_SESSION_PEPPER=replace-with-random-secret
SMAS_KEY_PEPPER=replace-with-another-random-secret
SMAS_DOWNLOAD_TOKEN_SECRET=replace-with-third-random-secret

# Ed25519 package signing; provide either a file path or inline PEM
# Ed25519 包签名；提供文件路径或内嵌 PEM，二选一
SMAS_SIGNING_PRIVATE_KEY_FILE=data/secrets/signing-key.pem
SMAS_SIGNING_PRIVATE_KEY=
SMAS_SIGNING_KEY_ID=local-dev-key

# GitHub OAuth App configuration
# GitHub OAuth 应用配置
SMAS_GITHUB_API_URL=https://api.github.com
SMAS_GITHUB_TIMEOUT=10
SMAS_GITHUB_CLIENT_ID=
SMAS_GITHUB_CLIENT_SECRET=
SMAS_GITHUB_CALLBACK_URL=http://127.0.0.1:8787/v1/auth/github/callback

# Browser origins for OAuth popup messages and WebSocket origin checks.
# Separate multiple origins with commas.
# 浏览器来源地址，用于 OAuth 弹窗消息和 WebSocket 来源校验。
# 多个来源地址使用逗号分隔。
SMAS_FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SMAS_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Service accounts for external services, as a JSON object of id to secret.
# The id becomes a principal in the users table, so grants and templates apply to it
# like any user; a numeric id is rejected because real identities are GitHub numeric ids.
# Secrets need at least 32 characters.
# 外部服务的服务号，JSON 对象：id 到密钥。
# id 会成为 users 表里的主体，授权与模板对它一视同仁；数字 id 会被拒绝，因为真实身份是
# GitHub 数字 id。密钥至少 32 个字符。
SMAS_SERVICE_ACCOUNTS=
# Example / 示例：SMAS_SERVICE_ACCOUNTS={"discord-bot":"<32+ character secret>"}

# Session and download-token lifetimes, in seconds
# 会话与下载令牌有效期，单位为秒
SMAS_SESSION_TTL=2592000
SMAS_DOWNLOAD_TOKEN_TTL=120

# Optional transactional email (SMTP)
# 可选的事务邮件（SMTP）
SMAS_SMTP_HOST=
SMAS_SMTP_PORT=587
SMAS_SMTP_USERNAME=
SMAS_SMTP_PASSWORD=
SMAS_SMTP_USE_TLS=1
SMAS_SMTP_TIMEOUT=10
SMAS_EMAIL_FROM=
SMAS_EMAIL_POLL_INTERVAL=15

# S3-compatible object storage; used only with s3/s3+http/s3+https storage URLs
# With object storage the download endpoint answers 302 to a short-lived signed URL,
# so the bucket origin is published in /v1/server-info download_origins (derived from
# the storage URL; add SMAS_DOWNLOAD_ORIGINS for extra sources such as a CDN).
# 兼容对象存储；仅在对象存储 URL 使用 s3/s3+http/s3+https 时填写。
# 用对象存储时下载端点会 302 到短寿命签名 URL，因此桶的 origin 会出现在 /v1/server-info
# 的 download_origins 里（由存储 URL 推出；额外的 CDN 等来源写到 SMAS_DOWNLOAD_ORIGINS）。
SMAS_S3_BUCKET=
SMAS_S3_REGION=us-east-1
SMAS_S3_FORCE_PATH_STYLE=1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Extra download origins, comma separated; a bare host accepts https only.
# 额外的下载来源，逗号分隔；裸主机名只接受 https。
SMAS_DOWNLOAD_ORIGINS=
# Lifetime of the signed download URL, in seconds.
# 签名下载 URL 的有效期，单位为秒。
SMAS_DOWNLOAD_URL_TTL=300

# Admin UI development server; leave empty when the UI uses the current origin
# 管理界面开发服务器；使用当前来源地址时留空
VITE_API_ORIGIN=
