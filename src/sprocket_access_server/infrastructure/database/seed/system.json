        "description": "All system and Team permissions"
    },
    {
        "template_id": "template.superadmin",
        "name": "SuperAdmin",
        "nodes": ["system.*", "team.system.*", "team.template.*"],
        "description": "System administration permissions"
    },
    {
        "template_id": "template.user",
        "name": "User",
        "nodes": [
            "system.authentication.me.read",
            "system.authentication.me.authorization.read",
